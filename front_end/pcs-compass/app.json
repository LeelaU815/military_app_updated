{
  "expo": {
    "name": "PCS Compass",
    "slug": "snack-1f8497c2-d1e4-4b46-8c73-86b30460e5b9",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leelau.pcscompass"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#173A5E"
      },
      "package": "com.leelau.pcscompass"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#173A5E",
          "imageWidth": 200
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "PCS Compass adds your move dates and appointments to your calendar."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#173A5E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PCS Compass lets you save photos of documents, like your child's IEP or orders.",
          "cameraPermission": "PCS Compass lets you take photos of documents, like your child's IEP or orders."
        }
      ],
      "expo-sharing"
    ]
  }
}
